# Export these values in your process manager; this file is documentation, not auto-loaded.
PORT=8000
DATA_DIR=data
# Use 1 behind production HTTPS. Use 0 only for local HTTP development.
COOKIE_SECURE=1
# Set a long random one-time setup secret before publishing an unclaimed installation.
SETUP_SECRET=replace-with-a-long-random-value

# Optional for cross-site HTTPS iframe previews. Leave 0 for a standalone deployment.
COOKIE_PARTITIONED=0
